# Vercel Connect connector UID. The default is shown explicitly for local setup.
KNOWN_GOOD_REVIEW_GITHUB_CONNECTOR=github/known-good-review

# Optional for local development outside Vercel OIDC. Do not commit a value.
AI_GATEWAY_API_KEY=

# Convex HTTP-actions URL and a shared random bearer token. Set the same token
# as KNOWN_GOOD_REVIEW_MEMORY_TOKEN in the Convex deployment environment.
CONVEX_MEMORY_URL=
KNOWN_GOOD_REVIEW_MEMORY_TOKEN=

# Optional because this app uses the Chat SDK adapter only for authenticated
# outbound GitHub API access. Set it if the adapter is later given webhooks.
GITHUB_BOT_USER_ID=
