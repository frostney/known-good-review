# Your Vercel Connect connector UID. Replace this legacy instance default
# when self-hosting; see docs/install.md.
KNOWN_GOOD_REVIEW_GITHUB_CONNECTOR=github/known-good-review

# Optional for local development outside Vercel OIDC. Do not commit a value.
AI_GATEWAY_API_KEY=

# Required app-only evidence authentication key: 32 random bytes as 64 hex
# characters. Keep stable across replicas/restarts; never pass to the sandbox.
KNOWN_GOOD_REVIEW_EVIDENCE_KEY=

# Convex HTTP-actions URL and a shared random bearer token. Set the same token
# as KNOWN_GOOD_REVIEW_MEMORY_TOKEN in the Convex deployment environment.
CONVEX_MEMORY_URL=
KNOWN_GOOD_REVIEW_MEMORY_TOKEN=

# Set your immutable GitHub bot user ID when self-hosting or renaming. Without
# it, only GitHub Bot authors named known-good-review[bot] are trusted.
GITHUB_BOT_USER_ID=
