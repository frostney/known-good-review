{
  "name": "known-good-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "imports": {
    "#*": "./agent/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "eve build --skip-sandbox-prewarm",
    "check": "bun run typecheck && bun test && bun run eve:info && bun run build",
    "dev": "eve dev",
    "eve:info": "eve info --json",
    "start": "eve start",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chat-adapter/github": "4.38.0",
    "@octokit/rest": "22.0.1",
    "@opentelemetry/api": "1.9.1",
    "@vercel/connect": "0.8.0",
    "@vercel/sandbox": "3.0.0",
    "ai": "7.0.66",
    "chat": "4.38.0",
    "eve": "0.38.3",
    "workflow": "5.0.0-beta.42",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ai": "7.0.66"
  },
  "engines": {
    "node": "24.x"
  }
}
